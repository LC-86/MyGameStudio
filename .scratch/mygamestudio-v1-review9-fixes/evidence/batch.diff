+++TOKEN_ENVS = ("MGS_GITHUB_TOKEN", "GH_TOKEN")
+++# 测试接缝:覆盖 API 端点(默认按 host 推导);验收与本地替身使用
+++API_BASE_ENV = "MGS_GH_API_BASE"
