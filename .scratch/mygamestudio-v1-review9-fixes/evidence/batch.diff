++def api_base_for(config: dict, override: str | None = None) -> str:
++    """API 端点:override/环境变量优先,否则按 host 推导。
++
++    无仓库坐标的配置(如本地后端项目做交接可达检查)退回 github.com
++    端点——可达检查访问的是绝对引用 URL,端点仅作兜底。
++    """
