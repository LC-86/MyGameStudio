++                                   "(原生 sub-issue)"},
++                        change_note="设置父任务(原生)")
++                    result["mode"] = "native-sub-issues"
++                    result["readback"]["body"] = result["readback"].get("body", "")
++                    return result
++            except TransportError as exc:
