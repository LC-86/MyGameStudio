++                                    if c.get("body") == comment_body), None)
++                        if hit is not None:
++                            comment = hit
++                            attempts.append({"step": "readback", "outcome": "exists"})
++                            break
++                        attempts.append({"step": "readback", "outcome": "absent"})
++                    else:
